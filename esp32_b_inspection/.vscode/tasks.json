{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Build",
      "type": "esp-idf",
      "command": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Tests: Python",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools",
        "-p",
        "test_tools.py",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test Gateway: Run",
      "type": "process",
      "command": "python",
      "args": [
        "tools/test_gateway.py",
        "--scenario",
        "${input:scenario}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "scenario",
      "type": "pickString",
      "description": "Hardware test scenario",
      "options": [
        "normal",
        "heartbeat-loss",
        "result-retries"
      ],
      "default": "normal"
    }
  ]
}
